fold.compare_svm <- function (resualts,x){
  for (i in 1:x){
    accuracy_folds <- resualts_table_svm_m_gbm[[i]]$Accuracy
    diff_matrix <- outer(accuracy_folds,accuracy_folds, "-")
    abs_diff_matrix <- abs(diff_matrix)
    write.csv(abs_diff_matrix,paste0("svm_m_fold_differences_",i,".csv"), row.names = T)
    saveRDS(abs_diff_matrix,paste0("C:/Users/avive/Documents/Thesis/R code/Thesis/Bachlor/Working/SVM/male/svm_m_fold_differences_",i))

    diff_df <- as.data.frame(abs_diff_matrix)
    diff_df$Fold <- rownames(diff_df)
    diff_long <- diff_df %>%
      pivot_longer(
        cols = -Fold,
        names_to = "Fold2",
        values_to = "Difference"
      )


    plot <- ggplot(diff_long, aes(x = Fold, y = Fold2, fill = Difference)) +
      geom_tile() +
      scale_fill_gradient(low = "white", high = "lightblue", name = "Abs. Diff.") +
      theme_minimal() +
      labs(title = paste0("svm cross validation fold differences males only run ",i))
    theme_minimal() +
      theme(axis.text.x = element_text(angle = 45, hjust = 1))
    print(plot)
  }
}
