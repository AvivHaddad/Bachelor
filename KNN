cross.validation.KNN <- function (data,x,seed){
  path <- "C:/Users/avive/Documents/Thesis/R code/Thesis/Bachlor/Working//KNN"
  data$group <- as.factor(data$group)


  set.seed(seed = seed)

  folds <- createFolds(data$group,
                       k = x, list = TRUE,
                       returnTrain = TRUE)

  for (i in 1:x){
    train_idx <- folds[[i]]
    test_idx <- setdiff(seq_len(nrow(data)),train_idx)
    training <- data[train_idx,]
    test <- data[test_idx,]
    fitControl <- trainControl(
      method = "repeatedcv",
      number = x
    )

    test_pred <- train(
      group ~.,
      data = training,
      method = "knn",
      trControl = fitControl,
      tuneGrid = data.frame(k = c(3,5,7))
    )

    predictions <- predict(test_pred,test,type = "raw")
    mat <- confusionMatrix(predictions, test$group)
    saving_path <- paste0(path,"/table_KNN_",i)
    saveRDS(mat,saving_path)

    # Combine into a data frame
    df <- data.frame(
      Sensitivity = mat$byClass[,1],
      Specificity = mat$byClass[,2],
      B.Accuracy = mat$byClass[,11]
    )

    saving_path_df <- paste0(path,"/DF_KNN_",i)
    saveRDS(df,saving_path_df)

  }
}


