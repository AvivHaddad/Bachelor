cross.validation <- function (data,x,seed){
  acc_list <- list()
  path <- "C:/Users/avive/Documents/Thesis/R code/Thesis/Bachlor/Working/Reusable Files/Cross Validation gbm"
  training_data <- data[
    rownames(data) != "gene_id" & rownames(data) != "gene_name",]
  training_data$group <- as.factor(training_data$group)


  set.seed(seed = seed)

  folds <- createFolds(training_data$group,
                       k = x, list = TRUE,
                       returnTrain = TRUE)

  for (i in 1:x){
    train_idx <- folds[[i]]
    test_idx <- setdiff(seq_len(nrow(training_data)),train_idx)
    training <- training_data[train_idx,]
    test <- training_data[test_idx,]

    fitControl <- trainControl(
      method = "repeatedcv",
      number = x
    )
    gbmFit <- train(group ~ .,
                    data = training,
                    method = "gbm",
                    trControl = fitControl,
                    verbose = FALSE)
    gbmFit
    saveRDS(gbmFit,file = paste0(path,"/gbm_",i))

    predictions <- predict(gbmFit, newdata = test)
    pred_path <- paste0(path, "/predictions_cv_", i)
    saveRDS(predictions, file = pred_path)

    compare <- data.frame(actual = test$group, predicted = predictions)
    comp_path <- paste0(path, "/comparison_cv_", i)
    saveRDS(compare, file = comp_path)

    acc <- mean(compare$actual == compare$predicted)
    acc_list[[i]] <- acc
  }
  saveRDS(acc_list, "C:/Users/avive/Documents/Thesis/R code/Thesis/Bachlor/Working/Reusable Files/Cross Validation gbm/acc_list")

}

