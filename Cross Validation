cross.validation <- function (data,x){
  error_list <- list()
  seed <- 100
  for (i in 1:x){
    set.seed(seed + i)
    training.samples <- data$mpg %>%
      createDataPartition(p = .8, list = FALSE)

    file <- paste0("C:/Users/avive/Documents/Thesis/R code/Thesis/Bachlor/Working/Reusable Files/training_data ",i)
    saveRDS(training.samples,file)

    train.data <- data[training.samples,]
    test.data <- data[-training.samples,]
    model <- lm(mpg ~.,data = train.data)
    predictions <- model %>% predict(test.data)
    saveRDS(predictions,paste0("C:/Users/avive/Documents/Thesis/R code/Thesis/Bachlor/Working/Reusable Files/predictions ",i))

    compare <- data.frame(actual = data$mpg, predicted = predictions)
    saveRDS(compare,paste0("C:/Users/avive/Documents/Thesis/R code/Thesis/Bachlor/Working/Reusable Files/comparison ",i))
    error <- RMSE(predictions, test.data$mpg)
    error_list[[i]] <- error
  }
  saveRDS(error_list,"C:/Users/avive/Documents/Thesis/R code/Thesis/Bachlor/Working/Reusable Files/error_list")

}
