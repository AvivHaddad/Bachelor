##Creat a data frame of the genes and their logFC for the GSEA
res_diag_0<- readRDS("C:/Users/avive/Documents/Thesis/R code/Thesis/Bachlor/Working/Reusable Files/res_diag_0")
res_diag_0$Gene <- genXID$Gene[match(res_diag_0$ID,genXID$ID)]
res_diag_0_rank <- res_diag_0 %>%
  dplyr::select(Gene,logFC) %>%
  na.omit() %>%
  distinct() %>%
  group_by(Gene) %>%
  summarise(LCF=mean(logFC))

##deframe to a list
ranks_diag_0 <-  deframe(res_diag_0_rank)

rank_diag_0 <- ranks_diag_0[names(ranks_diag_0) != ""]

##Upload the pathway to the datasets I downloaded from https://www.gsea-msigdb.org/gsea/msigdb/human/collections.jsp#H
pathway.gene_all <- gmtPathways("C:/Users/avive/Documents/Thesis/R code/Thesis/Bachlor/Working/h.all.v2026.1.Hs.symbols.gmt")

##Run the GSEA
fgseaRes_diag_0 <- fgsea(pathways = pathway.gene_all, stats = rank_diag_0)

##Clean the table
fgseaRes_diag_0_clean <- fgseaRes_diag_0 %>%
  as_tibble() %>%
 arrange(desc(NES))

fgseaRes_diag_0_clean %>%
  dplyr::select(-leadingEdge,-ES) %>%
    arrange(padj) %>%
  DT::datatable()

saveRDS(fgseaRes_diag_0_clean,"C:/Users/avive/Documents/Thesis/R code/Thesis/Bachlor/Working/Reusable Files/fgseaRes_diag_0_clean")
fgseaRes_diag_0_clean <- readRDS("C:/Users/avive/Documents/Thesis/R code/Thesis/Bachlor/Working/Reusable Files/fgseaRes_diag_0_clean")

##Creat a top highest and lowest table
fgseaRes_diag_0_top_up <- head(fgseaRes_diag_0_clean, 30)
fgseaRes_diag_0_top_down <- tail(fgseaRes_diag_0_clean, 30)

fgseaRes_diag_0_tops <- rbind(fgseaRes_diag_0_top_up,fgseaRes_diag_0_top_down)
saveRDS(fgseaRes_diag_0_tops ,"C:/Users/avive/Documents/Thesis/R code/Thesis/Bachlor/Working/Reusable Files/fgseaRes_diag_0_tops ")
fgseaRes_diag_0_tops  <- readRDS("C:/Users/avive/Documents/Thesis/R code/Thesis/Bachlor/Working/Reusable Files/fgseaRes_diag_0_tops ")

##Plot to see who is at the top and who in the bottom
gsea_diag_0 <- ggplot(fgseaRes_diag_0_tops, aes(reorder(pathway,NES), NES)) +
  geom_col(aes(fill=padj<0.05)) +
  coord_flip() +
  labs(x="pathway", y="Normalized enrichment score", title = "GSEA Control Hallmark") +
  theme_minimal()

gsea_diag_0

