cross.validation.gbm.patients <- function (data,x,seed){
  acc_list <- list()
  path <- "C:/Users/avive/Documents/Thesis/R code/Thesis/Bachlor/Working/Reusable Files/Cross Validation gbm/patients"
  data$group <- as.factor(data$group)
  data$group <- droplevels(data$group)

  set.seed(seed = seed)

  folds <- createFolds(data$group,
                       k = x, list = TRUE,
                       returnTrain = TRUE)

  for (i in 1:x){
    train_idx <- folds[[i]]
    test_idx <- setdiff(seq_len(nrow(data)),train_idx)
    training <- data[train_idx,]
    test <- data[test_idx,]

    fitpatients <- trainControl(
      method = "repeatedcv",
      number = x
    )
    gbmFit <- train(group ~ .,
                    data = training,
                    method = "gbm",
                    trControl = fitpatients,
                    verbose = FALSE)
    gbmFit
    saveRDS(gbmFit,file = paste0(path,"/gbm_patients_",i))

    predictions <- predict(gbmFit, newdata = test)
    pred_path <- paste0(path, "/predictions_gbm_patients_", i)
    saveRDS(predictions, file = pred_path)

    compare <- data.frame(actual = test$group, predicted = predictions)
    comp_path <- paste0(path, "/comparison_gbm_patients_", i)
    saveRDS(compare, file = comp_path)

    acc <- mean(compare$actual == compare$predicted)
    acc_list[[i]] <- acc
  }
  saveRDS(acc_list, "C:/Users/avive/Documents/Thesis/R code/Thesis/Bachlor/Working/Reusable Files/Cross Validation gbm/patients/acc_list")

}

