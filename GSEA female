#All female
res_diag_f$Gene <- genXID$Gene[match(res_diag_f$ID,genXID$ID)]
#Creat a data frame of the genes and their logFC for the GSEA
res_diag_f_rank <- res_diag_f %>%
  dplyr::select(Gene,logFC) %>%
  na.omit() %>%
  distinct() %>%
  group_by(Gene) %>%
  summarise(LogFC=mean(logFC))

#deframe to a list
ranks_diag_f<-  deframe(res_diag_f_rank)

rank_diag_f <- ranks_diag_f[names(ranks_diag_f) != ""]

rank_diag_f <- sort(rank_diag_f, decreasing = TRUE)

#Upload the pathway to the datasets I downloaded from https://www.gsea-msigdb.org/gsea/msigdb/human/collections.jsp#H
pathway.gene_all <- gmtPathways("C:/Users/avive/Documents/Thesis/R code/Thesis/Bachlor/Working/h.all.v2026.1.Hs.symbols.gmt")

#Run the GSEA
fgseares_diag_f <- fgsea(pathways = pathway.gene_all, stats = rank_diag_f, nperm = 1000)

#Clean the table
fgseares_diag_f_clean <- fgseares_diag_f %>%
  as_tibble() %>%
  arrange(desc(NES))

fgseares_diag_f_clean %>%
  dplyr::select(-leadingEdge,-ES,-nMoreExtreme) %>%
  arrange(padj) %>%
  DT::datatable()

#Creat a top highest and lowest table
fgseares_diag_f_top_up <- head(fgseares_diag_f_clean, 20)
fgseares_diag_f_top_down <- tail(fgseares_diag_f_clean, 20)

fgseares_diag_f_tops <- rbind(fgseares_diag_f_top_up,fgseares_diag_f_top_down)

#Plot to see who is at the top and who in the bottom
gsea_diag_f <- ggplot(fgseares_diag_f_tops, aes(reorder(pathway,NES), NES)) +
  geom_col(aes(fill=padj<0.05)) +
  coord_flip() +
  labs(x="pathway", y="Normalized enrichment score", title = "GSEA diag female Hallmark") +
  theme_minimal()

