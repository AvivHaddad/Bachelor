cross.validation.gbm.train_m.trest_f <- function (training,test,x,seed){
  acc_list <- list()
  path <- "C:/Users/avive/Documents/Thesis/R code/Thesis/Bachlor/Working/Reusable Files/Cross Validation gbm/male Train female Test"
  training$group <- as.factor(training$group)
  training$group <- droplevels(training$group)

  set.seed(seed = seed)

  folds <- createFolds(training$group,
                       k = x, list = TRUE,
                       returnTrain = TRUE)

  for (i in 1:x){
    train_idx <- folds[[i]]
    train_data <- training[train_idx,]
    test_data <- test

    fitControl <- trainControl(
      method = "repeatedcv",
      number = x
    )
    gbmFit <- caret::train(group ~ .,
                    data = train_data,
                    method = "gbm",
                    trControl = fitControl,
                    verbose = FALSE)
    gbmFit
    saveRDS(gbmFit,file = paste0(path,"/gbm_train_m_test_f",i))

    predictions <- predict(gbmFit, newdata = test)
    pred_path <- paste0(path, "/predictions_gbm_train_m_test_f", i)
    saveRDS(predictions, file = pred_path)

    compare <- data.frame(actual = test$group, predicted = predictions)
    comp_path <- paste0(path, "/comparison_gbm_train_m_test_f", i)
    saveRDS(compare, file = comp_path)

    acc <- mean(as.character(compare$actual) == as.character(compare$predicted))
    acc_list[[i]] <- acc
  }
  saveRDS(acc_list, "C:/Users/avive/Documents/Thesis/R code/Thesis/Bachlor/Working/Reusable Files/Cross Validation gbm/male Train female Test/acc_list")

}

