#Extract the genes from the pathways
leading_gene_table <- do.call(rbind, lapply(seq_len(nrow(top_big_table)), function(i) {
  data.frame(
    comparison = top_big_table$comparison[i],
    pathway = top_big_table$pathway[i],
    NES = top_big_table$NES[i],
    padj = top_big_table$padj[i],
    gene = unlist(top_big_table$leadingEdge[i]),
    stringsAsFactors = FALSE
  )
}))
leading_gene_table <- unique(leading_gene_table)
gene_rank_table <- aggregate(
  pathway ~ gene,
  data = leading_gene_table,
