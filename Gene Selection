pathwayTableCleaning <- function(x) {
  x %>%
    dplyr::select(pathway, padj, NES, leadingEdge, size) %>%
    dplyr::arrange(padj)
}

#Creat a big matrix with all of the GSEA resualts
table_list <- list(
  pathsways_diag = fgseares_diag_tops,
  pathsways_diag_C2 = fgseares_diag_C2_tops,
  pathsways_diag_Brain = fgseares_diag_Brain_tops,
  pathsways_diag_0 = fgseares_diag_0_tops,
  pathsways_diag_0_C2 = fgseares_diag_0_C2_tops,
  pathsways_diag_0_Brain = fgseares_diag_0_Brain_tops,
  pathsways_diag_2 = fgseares_diag_2_tops,
  pathsways_diag_2_C2 = fgseares_diag_2_C2_tops,
  pathsways_diag_2_Brain = fgseares_diag_2_Brain_tops,
  pathsways_diag_f = fgseares_diag_f_tops,
  pathsways_diag_f_C2 = fgseares_diag_f_C2_tops,
  pathsways_diag_f_Brain = fgseares_diag_f_Brain_tops,
  pathsways_diag_m = fgseares_diag_m_tops,
  pathsways_diag_m_C2 = fgseares_diag_m_C2_tops,
  pathsways_diag_m_Brain = fgseares_diag_m_Brain_tops,
  pathsways_gender = fgseares_gender_tops,
  pathsways_gender_C2 = fgseares_gender_C2_tops,
  pathsways_gender_Brain = fgseares_gender_Brain_tops
)

big_table <- imap_dfr(table_list, ~
  pathwayTableCleaning(.x) %>%
    mutate(comparison = .y)
)
#Creat scoring
big_table <- big_table %>%
  mutate(
    absNES = abs(NES),
    score = -log10(padj) * absNES
  )
#remove 0 adj. P values
big_table <- big_table %>%
  mutate(padj = ifelse(padj == 0, 1e-300, padj))

to_filter_out_pathways <- c("RUNNE_GENDER_EFFECT_UP","DISTECHE_ESCAPED_FROM_X_INACTIVATION","Park_2011_Coexpression_Hippocampus_Mouse_lightyellow")
big_table_filtered <- big_table[!big_table$pathway %in% to_filter_out_pathways, ]

#Which comes up the most
pathway_summary <- big_table_filtered %>%
  group_by(pathway) %>%
  summarise(
    n_comp = n(),
    best_padj = min(padj, na.rm = TRUE),
    max_absNES = max(absNES, na.rm = TRUE),
    best_score = max(score, na.rm = TRUE),
    comparisons = paste(unique(comparison), collapse = "; "),
    .groups = "drop"
  ) %>%
  arrange(best_padj, desc(max_absNES))

top_pathways_general <- head(pathway_summary,20)

#Give the Brain data set more weight
big_table_weighted_brain <- big_table_filtered %>%
  mutate(weight = case_when(
    grepl("Brain", comparison, ignore.case = TRUE) ~ 2,
    TRUE ~ 1
  )) %>%
  mutate(weighted_score = score * weight)
pathway_summary_weighted_brain <- big_table_weighted_brain %>%
  group_by(pathway) %>%
  summarise(
    total_weighted_score = sum(weighted_score, na.rm = TRUE),
    n_comp = n(),
    best_padj = min(padj, na.rm = TRUE),
    max_absNES = max(absNES, na.rm = TRUE),
    comparisons = paste(unique(comparison), collapse = "; "),
    .groups = "drop"
  ) %>%
  arrange(desc(total_weighted_score), best_padj)

#Brain weighted Pathways
top_brain_weighed_pathwayes <- head(pathway_summary_weighted_brain,60)

#Giving diagnosed (2) more weight
