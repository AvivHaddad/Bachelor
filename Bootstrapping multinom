# A bootstrapping function that receives a data matrix, number of folds and an original seed. It will run in a loop for the number of folds.
# In the loop the data will be partitioned to 90% training data and 10% testing.
#The data sets will be cleaned from NA and unnessasary rows and colums. The only data left will be the numerical expretions.
#This will be saved.
#The model uses the multinom function with a formula to group the data according to the groups in the column group.
#the predictions are saved as well.
#Then there is a data frame built with the predictions and the actual group to use for comparison.
#The accuracy is calculated and saved in the error list.
Bootsrapping <- function(data, x=10, seed = 123) {
  dir <- "C:/Users/avive/Documents/Thesis/R code/Thesis/Bachlor/Working/Reusable Files/Multinom"
  gene_cols <- names(data)[!names(data) %in% "group"]
  error_list <- list()

  for (i in 1:x) {
    set.seed(seed + i)

    train.indices <- createDataPartition(
      data$group,
      p = 0.9,
      list = FALSE
    )
    train.data <- data[train.indices, ]
    test.data  <- data[-train.indices, ]
    clean_numeric <- function(x) {
      # Replace common placeholders with NA before conversion
      x <- ifelse(x == "." | x == "NA" | x == "?" | x == "", NA, x)
      suppressWarnings(as.numeric(x))
    }
    train.data[, gene_cols]  <- lapply(train.data[, gene_cols], clean_numeric)
    test.data[, gene_cols]  <- lapply(test.data[, gene_cols], clean_numeric)

    train.data<- train.data[rownames(train.data) != "gene_id",]
    train.data<- train.data[rownames(train.data) != "gene_name",]


    train.data[, gene_cols] <- lapply(train.data[, gene_cols], as.numeric)
    test.data[, gene_cols]  <- lapply(test.data[, gene_cols], as.numeric)
    saveRDS(train.data,file = paste0(dir,"/training_data_",i))
    saveRDS(test.data,file = paste0(dir,"/test_data_",i))

    formula_str <- paste("group ~ ", paste(gene_cols, collapse = " + "))

    model <- multinom(
      as.formula(formula_str),
      data = train.data,
      trace = FALSE,
      MaxNWts = 50000
    )

    predictions <- predict(model, newdata = test.data)
    pred_path <- paste0(dir, "/predictions_", i)
    saveRDS(predictions, file = pred_path)

    compare <- data.frame(actual = test.data$group, predicted = predictions)
    comp_path <- paste0(dir, "/comparison_", i)
    saveRDS(compare, file = comp_path)

    acc <- mean(compare$actual == compare$predicted)
    error_list[[i]] <- acc
  }

  saveRDS(error_list, file = paste0(dir, "/error_list"))
}



