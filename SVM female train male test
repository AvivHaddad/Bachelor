cross.validation.SVM.ftmt <- function(training, testing, x, seed){

  acc_list <- list()

  path <- "C:/Users/avive/Documents/Thesis/R code/Thesis/Bachlor/Working/SVM/female Train male Test"

  training$group <- as.factor(training$group)
  training$group <- droplevels(training$group)

  set.seed(seed = seed)

  folds <- createFolds(
    training$group,
    k = x,
    list = TRUE,
    returnTrain = TRUE
  )

  for (i in 1:x){

    train_idx <- folds[[i]]

    train_data <- training[train_idx,]
    test_data <- testing

    fitControl <- trainControl(
      method = "repeatedcv",
      number = x
    )

    svm_ftmt_pred <- caret::train(
      group ~ .,
      data = train_data,
      method = "svmPoly",
      trControl = fitControl,
      tuneLength = 4
    )

    svm_ftmt_pred

    saveRDS(
      svm_ftmt_pred,
      file = paste0(path, "/svm_ftmt_", i)
    )

    predictions <- predict(
      svm_ftmt_pred,
      newdata = test_data
    )

    pred_path <- paste0(
      path,
      "/predictions_svm_ftmt_",
      i
    )

    saveRDS(predictions, file = pred_path)

    compare <- data.frame(
      actual = test_data$group,
      predicted = predictions
    )

    comp_path <- paste0(
      path,
      "/comparison_svm_ftmt_",
      i
    )

    saveRDS(compare, file = comp_path)

    acc <- mean(
      as.character(compare$actual) ==
        as.character(compare$predicted)
    )

    acc_list[[i]] <- acc
  }

  saveRDS(
    acc_list,
    "C:/Users/avive/Documents/Thesis/R code/Thesis/Bachlor/Working/SVM/female Train male Test/acc_list"
  )
}

