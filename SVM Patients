cross.validation.SVM <- function (data,x,seed){
  acc_list <- list()
  path <- "C:/Users/avive/Documents/Thesis/R code/Thesis/Bachlor/Working/SVM/Patients"
  data$group <- as.factor(data$group)
  data$group <- droplevels(data$group)

  set.seed(seed = seed)

  folds <- createFolds(data$group,
                       k = x, list = TRUE,
                       returnTrain = TRUE)

  for (i in 1:x){
    train_idx <- folds[[i]]
    test_idx <- setdiff(seq_len(nrow(data)),train_idx)
    training <- data[train_idx,]
    test <- data[test_idx,]
    fitControl <- trainControl(
      method = "repeatedcv",
      number = x
    )

    svm_2_pred <- train(
      group ~.,
      data = training,
      method = "svmPoly",
      trControl = fitControl,
      tuneLength = 4
    )
    svm_2_pred
    saveRDS(svm_2_pred,file = paste0(path,"/svm_2_",i))

    predictions <- predict(svm_2_pred, newdata = test)
    pred_path <- paste0(path, "/predictions_svm_2_", i)
    saveRDS(predictions, file = pred_path)

    compare <- data.frame(actual = test$group, predicted = predictions)
    comp_path <- paste0(path, "/comparison_svm_2_", i)
    saveRDS(compare, file = comp_path)

    acc <- mean(compare$actual == compare$predicted)
    acc_list[[i]] <- acc
  }
  saveRDS(acc_list, "C:/Users/avive/Documents/Thesis/R code/Thesis/Bachlor/Working/SVM/Patients/acc_list")

}

