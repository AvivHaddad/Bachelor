#All male
res_diag_m$Gene <- genXID$Gene[match(res_diag_m$ID,genXID$ID)]
#Creat a data frame of the genes and their logFC for the GSEA
res_diag_m_rank <- res_diag_m %>%
  dplyr::select(Gene,logFC) %>%
  na.omit() %>%
  distinct() %>%
  group_by(Gene) %>%
  summarise(LCF=mean(logFC))

#deframe to a list
ranks_diag_m <-  deframe(res_diag_m_rank)

rank_diag_m <- ranks_diag_m[names(ranks_diag_m) != ""]
saveRDS(rank_diag_m,"C:/Users/avive/Documents/Thesis/R code/Thesis/Bachlor/renk_diag_m")
rank_diag_m <- readRDS("C:/Users/avive/Documents/Thesis/R code/Thesis/Bachlor/renk_diag_m")

#Upload the pathway to the datasets I downloaded from https://www.gsea-msigdb.org/gsea/msigdb/human/collections.jsp#H
pathway.gene_all <- gmtPathways("C:/Users/avive/Documents/Thesis/R code/Thesis/Bachlor/Working/h.all.v2026.1.Hs.symbols.gmt")

#Run the GSEA
fgseares_diag_m <- fgsea(pathways = pathway.gene_all, stats = rank_diag_m, nperm = 1000)

#Clean the table
fgseares_diag_m_clean <- fgseares_diag_m %>%
  as_tibble() %>%
  arrange(desc(NES))

fgseares_diag_m_clean %>%
  dplyr::select(-leadingEdge,-ES,-nMoreExtreme) %>%
  arrange(padj) %>%
  DT::datatable()

#Creat a top highest and lowest table
fgseares_diag_m_top_up <- head(fgseares_diag_m_clean, 20)
fgseares_diag_m_top_down <- tail(fgseares_diag_m_clean, 20)

fgseares_diag_m_tops <- rbind(fgseares_diag_m_top_up,fgseares_diag_m_top_down)

#Plot to see who is at the top and who in the bottom
gsea_diag_m <- ggplot(fgseares_diag_m_tops, aes(reorder(pathway,NES), NES)) +
  geom_col(aes(fill=padj<0.05)) +
  coord_flip() +
  labs(x="pathway", y="Normalized enrichment score", title = "GSEA diag male Hallmark") +
  theme_minimal()

gsea_diag_m

