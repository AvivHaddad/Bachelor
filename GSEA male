fgseares_diag_m_Brain <- fgsea(pathways = pathway.gene_Brain_GMT, stats = rank_diag_m)

#Clean the table
fgseares_diag_m_Brain_clean <- fgseares_diag_m_Brain %>%
  as_tibble() %>%
  arrange(desc(NES))

fgseares_diag_m_Brain_clean %>%
  dplyr::select(-leadingEdge,-ES) %>%
  arrange(padj) %>%
  DT::datatable()

#Creat a top highest and lowest table
fgseares_diag_m_Brain_top_up <- head(fgseares_diag_m_Brain_clean, 30)
fgseares_diag_m_Brain_top_down <- tail(fgseares_diag_m_Brain_clean, 30)

fgseares_diag_m_Brain_tops <- rbind(fgseares_diag_m_Brain_top_up,fgseares_diag_m_Brain_top_down)

#Plot to see who is at the top and who in the bottom
gsea_diag_m_Brain <- ggplot(fgseares_diag_m_Brain_tops, aes(reorder(pathway,NES), NES)) +
  geom_col(aes(fill=padj<0.05)) +
  coord_flip() +
  labs(x="pathway", y="Normalized enrichment score", title = "GSEA diag male Brain") +
  theme_minimal()

gsea_diag_m_Brain
