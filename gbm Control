matrix.build <- function (comparisons){
  groups <- sort(unique(comparisons$actual))
  groups
  pred <- comparisons$predicted
  actual <- comparisons$actual
  actual <- factor(actual, levels = groups)
  pred <- factor(pred, levels = groups)
  res_table <- table(actual,pred)
  var_name <- deparse(substitute(comparisons))
  path <- paste0("C:/Users/avive/Documents/Thesis/R code/Thesis/Bachlor/Working/Reusable Files/Cross Validation gbm/control/",var_name,"sum_pred_table")
  saveRDS(res_table,path)
  matrix <- matrix(0,3,3)
  rownames(matrix) <- c(rownames(res_table),"Total")
  colnames(matrix) <- c(colnames(res_table),"Correct")
  matrix[1:2,1:2] <- res_table
  matrix[1:2,3] <- diag(res_table)
  matrix[3,3] <- sum(diag(res_table))
  return(matrix)
}
