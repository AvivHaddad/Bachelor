##Creat a data frame of the genes and their logFC for the GSEA
## I have a problem of many of the genes gettin equal rating and it can creat unpredictible resualts.
## I've tried changing to t-values, but it didn't matter
res_diag_2<- readRDS("C:/Users/avive/Documents/Thesis/R code/Thesis/Bachlor/Working/Reusable Files/res_diag_2")
res_diag_2$Gene <- genXID$Gene[match(res_diag_2$ID,genXID$ID)]

res_diag_2_rank <- res_diag_2 %>%
  dplyr::select(Gene,logFC) %>%
  na.omit() %>%
  distinct() %>%
  group_by(Gene) %>%
  summarise(LCF=mean(logFC))

##deframe to a list
ranks_diag_2 <-  deframe(res_diag_2_rank)

rank_diag_2 <- ranks_diag_2[names(ranks_diag_2) != ""]

##Upload the pathway to the datasets I downloaded from https://www.gsea-msigdb.org/gsea/msigdb/human/collections.jsp#H
pathway.gene_all <- gmtPathways("C:/Users/avive/Documents/Thesis/R code/Thesis/Bachlor/Working/h.all.v2026.1.Hs.symbols.gmt")

##Run the GSEA
fgseaRes_diag_2 <- fgsea(pathways = pathway.gene_all, stats = rank_diag_2)

##Clean the table
fgseaRes_diag_2_clean <- fgseaRes_diag_2 %>%
  as_tibble() %>%
 arrange(desc(NES))

fgseaRes_diag_2_clean %>%
  dplyr::select(-leadingEdge,-ES) %>%
  arrange(padj) %>%
  DT::datatable()

saveRDS(fgseaRes_diag_2_clean,"C:/Users/avive/Documents/Thesis/R code/Thesis/Bachlor/Working/Reusable Files/fgseaRes_diag_2_clean")
fgseaRes_diag_2_clean <- readRDS("C:/Users/avive/Documents/Thesis/R code/Thesis/Bachlor/Working/Reusable Files/fgseaRes_diag_2_clean")

##Creat a top highest and lowest table
fgseaRes_diag_2_top_up <- head(fgseaRes_diag_2_clean, 30)
fgseaRes_diag_2_top_down <- tail(fgseaRes_diag_2_clean, 30)

fgseaRes_diag_2_tops <- rbind(fgseaRes_diag_2_top_up,fgseaRes_diag_2_top_down)
saveRDS(fgseaRes_diag_2_tops ,"C:/Users/avive/Documents/Thesis/R code/Thesis/Bachlor/Working/Reusable Files/fgseaRes_diag_2_tops ")
fgseaRes_diag_2_tops  <- readRDS("C:/Users/avive/Documents/Thesis/R code/Thesis/Bachlor/Working/Reusable Files/fgseaRes_diag_2_tops ")

##Plot to see who is at the top and who in the bottom
gsea_diag_2 <- ggplot(fgseaRes_diag_2_tops, aes(reorder(pathway,NES), NES)) +
  geom_col(aes(fill=padj<0.05)) +
  coord_flip() +
  labs(x="pathway", y="Normalized enrichment score", title = "GSEA BI Polar Patients Hallmark") +
  theme_minimal()

gsea_diag_2

