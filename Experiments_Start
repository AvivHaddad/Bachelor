# Building a design matrix
pheno_full <- as.data.frame(gse@phenoData@data)

pheno <- pheno_full
pheno$diagnosis <- factor(pheno$diagnosisbp1, levels = c("0","2"))
pheno$gender <- factor(pheno$gender, levels = c("f","m"))

expr_mat <- exprs(gse)
identical(rownames(pheno), colnames(expr_mat))

#1. Full set - Sex+Diagnosis
design_diag_sex <- model.matrix(~ diagnosis + gender, data = pheno)
fit_diag_sex <- lmFit(exprs(gse), design_diag_sex)
fit_diag_sex <- eBayes(fit_diag_sex)

# Making logFCerent experiments using topTable
# Diagnosis - 0VS2
res_diag <- topTable(fit_diag_sex, coef = "diagnosis2", number = Inf)
res_diag_CSV <- write.csv(res_diag, "../res_diag.csv", row.names = T)
high_B_genes_res_diag <- res_diag[order(-res_diag$B), ]
high_B_genes_res_diag <- high_B_genes_res_diag[1:50,]
write.csv(high_B_genes_res_diag, "../high_B_genes_res_diag", row.names = T)
high_logFC_genes_res_diag <- res_diag[order(-res_diag$logFC), ]
high_logFC_genes_res_diag <- high_logFC_genes_res_diag[1:50,]
write.csv(high_logFC_genes_res_diag, "../high_logFC_genes_res_diag", row.names = T)


# Sex- mVSf
res_sex <- topTable(fit_diag_sex, coef ="genderm", number = Inf)

all(rownames(res_diag) %in% rownames(res_sex))
res_sex_ordered_diag<- res_sex[rownames(res_diag),]
identical(rownames(res_diag), rownames(res_sex_ordered_diag))
res_sex_CSV <- write.csv(res_sex, "../res_sex.csv", row.names = T)

high_B_genes_res_sex <- res_sex[order(-res_sex$B), ]
