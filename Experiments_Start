# Building a design matrix
pheno_full <- as.data.frame(gse@phenoData@data)

pheno <- pheno_full
pheno$diagnosis <- pheno[["diagnosisbp1:ch1"]]
pheno$sex       <- pheno[["gender:ch1"]]

pheno$diagnosis <- factor(pheno$diagnosis, levels = c("0","2"))
pheno$sex       <- factor(pheno$sex,       levels = c("f","m"))

expr_mat <- exprs(gse)
identical(rownames(pheno), colnames(expr_mat))

design_diag_sex <- model.matrix(~ diagnosis + sex, data = pheno)
fit_diag_sex <- lmFit(exprs(gse), design_diag_sex)
fit_diag_sex <- eBayes(fit_diag_sex)

# Making different experiments using topTable
# Diagnosis - 0VS2
res_diag <- topTable(fit_diag_sex, coef = "diagnosis2", number = Inf)
res_diag_CSV <- write.csv(res_diag, "res_diag.csv", row.names = T)


# Sex- mVSf
res_sex <- topTable(fit_diag_sex, coef ="sexm", number = Inf)

all(rownames(res_diag) %in% rownames(res_sex))
res_sex_ordered_diag<- res_sex[rownames(res_diag),]
identical(rownames(res_diag), rownames(res_sex_ordered_diag))
res_sex_CSV <- write.csv(res_sex, "res_sex.csv", row.names = T)

# Designe for both
design_diag_sex_both <- model.matrix(~diagnosis * sex, data = pheno)
fit_diag_sex_both <- lmFit(exprs(gse), design_diag_sex_both)
fit_diag_sex_both <- eBayes(fit_diag_sex_both)

res_both <- topTable(fit_diag_sex_both, coef = "diagnosis2:sexm", number = Inf)
res_both_ordered_diag <- res_both[rownames(res_diag),]
res_both_CSV <- write.csv(res_both, "res_both.csv", row.names = T)

# Only female experiments
idx_female <- pheno$sex == "f"

exprs_f <- exprs(gse)[,idx_female]
pheno_f <- droplevels(pheno[idx_female,])

design_f <- model.matrix(~diagnosis,data = pheno_f)
fit_f <- lmFit(exprs_f, design_f)
fit_f <- eBayes(fit_f)

res_diag_f <- topTable(fit_f, coef = "diagnosis2", number = Inf)
res_diag_f_ordered_diag <- res_diag_f[rownames(res_diag),]
res_diag_f_CSV <- write.csv(res_diag_f, "res_diag_f.csv", row.names = T)

# Only male expirements
idx_male <- pheno$sex == "m"

exprs_m <- exprs(gse)[,idx_male]
pheno_m <- droplevels(pheno[idx_male,])

design_m <- model.matrix(~diagnosis,data = pheno_m)
fit_m <- lmFit(exprs_m, design_m)
fit_m <- eBayes(fit_m)

res_diag_m <- topTable(fit_m, coef  = "diagnosis2", number = Inf)
res_diag_m_ordered_diag <- res_diag_m[rownames(res_diag),]
res_diag_m_CSV <- write.csv(res_diag_m, "res_diag_m.csv", row.names = T)


